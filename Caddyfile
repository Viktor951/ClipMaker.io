# Reverse proxy de produção: TLS automático (Let's Encrypt), zstd/gzip, headers de segurança.
# DOMAIN=localhost  -> certificado interno auto-assinado (teste local)
# DOMAIN=app.exemplo.com -> certificado Let's Encrypt real (portas 80/443 acessíveis da internet)
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API: uploads grandes e processamento longo
	handle /api/* {
		request_body {
			max_size 2GB
		}
		reverse_proxy api:8000 {
			transport http {
				read_timeout 30m
				write_timeout 30m
				dial_timeout 10s
			}
		}
	}

	# Frontend estático (SPA)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
