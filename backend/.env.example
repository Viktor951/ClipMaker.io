# ==============================================
# ClipMakerAI — Variáveis de Ambiente
# ==============================================
# Copie este arquivo para .env e preencha os valores.
# NÃO COMMITE O ARQUIVO .env NO GIT!

# Chave da API do Google Gemini (obtenha em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="COLOQUE_SUA_CHAVE_AQUI"

DATABASE_URL="postgresql://postgres:password@localhost:5432/clipmaker_db"
REDIS_URL="redis://localhost:6379/0"

SECRET_KEY="gerar_nova_chave_segura_via_openssl"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=clipmaker_db
