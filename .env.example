# ClipMakerAI — variáveis de ambiente (copie para .env e preencha; NUNCA commite o .env)
# Gerar segredos:  powershell -File scripts\setup-prod.ps1   (ou: openssl rand -hex 32)
# Use apenas hexadecimal nas senhas (evita caracteres especiais em URLs de conexão).

# ── Domínio / TLS ──
DOMAIN=localhost                  # produção: seu.dominio.com
ENVIRONMENT=production

# ── Armazenamento (disco D:) ──
DATA_ROOT=D:/docker-data/clipmaker

# ── Aplicação ──
SECRET_KEY=                       # obrigatório: openssl rand -hex 32
GEMINI_API_KEY=

# ── Postgres ──
POSTGRES_USER=clipmaker
POSTGRES_PASSWORD=                # obrigatório
POSTGRES_DB=clipmaker_db

# ── Redis ──
REDIS_PASSWORD=                   # obrigatório

# ── Recursos do Worker e Hardware ──
WORKER_CPUS=4.0                       # Limite de CPU para o container worker (default 4.0)
WORKER_MEM_LIMIT=6g                   # Limite de RAM para o worker (default 6g)

# ── Pipeline de IA e Mídia ──
WHISPER_MODEL=small                   # Modelo Whisper ("small" para GPU, "base" para CPU, "tiny")
WHISPER_IDLE_TIMEOUT_MINUTES=15       # Minutos sem uso antes de descarregar o Whisper da memória
MAX_SOURCE_HEIGHT=1080                # Resolução máxima de download no yt-dlp

# ── Somente desenvolvimento local fora do Docker ──
# DATABASE_URL=postgresql://clipmaker:SENHA@localhost:5432/clipmaker_db
# REDIS_URL=redis://:SENHA@localhost:6379/0
